# =================================================================
# Frosti güncellemesi dosyaları yok sayıyor#
# Bu dosyada listelenen tüm dosyalar ve dizinler, frosti.update.sh betiği çalıştırıldığında üzerine yazılmayacaktır.
# Başka dosyaları özelleştirdiyseniz (örneğin, bir bileşenin stilini değiştirdiyseniz),
# Güncelleme sırasında sıfırlanmasını önlemek için lütfen bu dosyanın göreceli yolunu bu dosyaya ekleyin.
# =================================================================

# --- 核心配置文件 ---
frosti.config.yaml
src/i18n/translations.yaml

# --- Kullanıcı içeriği ---
# Tüm makalelerinizi ve sayfalarınızı koruyun.
src/content/
src/pages/
# Herkese açık dizine yerleştirdiğiniz tüm dosyaları (resimler, favicon'lar vb.) koruyun.
public/
# Kendi README dosyanızı koruyun.
README.md
docs/README.zh-CN.md

# --- Git ve çıktıyı oluştur ---
.git/
dist/
node_modules/

# --- Senaryolar ve senaryonun kendisi ---
frosti.update.sh
.updateignore