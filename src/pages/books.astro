---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@config";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import LinkCard from "@/components/mdx/LinkCard.astro";
import "@/styles/contactedit.scss";
---

<BaseLayout title="Kitaplık">
  <MainCard
    title="Kitaplık"
    description="Selamlar! 👋 Burası, severek okuduğum ve beni bazen heyecanlandıran bazen de bitse de gitsek dedirten tüm kitapların bir araya geldiği kitaplık köşem..."
    textOverlay="KİTAPLIK"
    infoIcon="lucide:book"
  >
  <h2 class="contact-title">📚 Kitap Aşkım Burada Başlıyor!</h2><br />
    <p class="contact-description">
    Selamlar! 👋 Burası, severek okuduğum ve beni bazen heyecanlandıran bazen de bitse de gitsek dedirten tüm kitapların bir araya geldiği kitaplık köşem. <br />
    Daha önceki yıllarda okuduğum kitapları şimdilik eklemedim, zamanla tümünü değil de sadece en beğendiğim kitapları eklemeyi düşünüyorum.<br />
    </p><br />
    <p>
    <b><a href="/blog/insan-okusun-diye-yaziyorum-bunlari/">Hayatım boyunca elimden kitap düşürmeyen biri olarak</a></b>, o kağıt kokusuna ve hikayelerin gücüne her zaman hayran kaldım. </p>
    <p></p>Her kitap seven kağıt kokusunu sever ama ekitap ve sesli kitaplar da kendine göre avantajları ile birlikte geliyor, onları da dışlamamamız gerektiğini düşünüyorum. Hatta çoğu zaman yanımda bir kitap taşıyamadığım için ekitap okumak daha kolay oluyor diyebilirim. </p>
    <p>Kitaplar bizi alıp bambaşka dünyalara götürüyor, yepyeni şeyler öğretiyor ve en önemlisi hayal gücümüzün sınırlarını zorluyor.</p></p>
    <br />
    <p>
    Yıllar geçtikçe okuma tutkum daha da arttı.</p>
    <p></p>Emeklilik planlarımda, bol bol kitap okuma hayali en baş köşede duruyor.</p>
    <br />
    <p>
    Koleksiyonuma katmak için sürekli yeni maceralar, ilginç fikirler ve heyecan verici sayfalar arıyorum.
    </p><br />
    <p>
    Eğer "Buna kesinlikle bayılırsın!" dediğin bir kitap varsa, lütfen hiç çekinme! <b><a href="/contact.astro">Bana ulaşıp</a></b> tavsiye vermen beni çok mutlu eder. 🥳
    </p><br />
    <section>
    <h2 class="contact-title">Okumaya Devam Ettiklerim</h2><br />
    <div class="grid grid-cols-1 md:grid-cols-1 gap-6">
        <LinkCard
          title="Ezbere Yaşayanlar - Vazgeçemediğimiz Alışkanlıklarımızın Kökenleri"
          writer="Emrah Sefa Gürkan (1981; Değirmendere, Kocaeli)"
          desc="Ezbere Yaşayanlar’da iki yüz bin yıllık insanlık mirasının ortaya koyduğu birbirinden değişik toplum ve kültüre yönelerek davranışlarımızı şekillendiren ana etmenleri inceleyecek; kültürle biyoloji, geçmişle gelecek, gelenekle yenilik arasındaki çekişmeyi merkeze alarak, şartların alışkanlıklarımızı ne noktaya kadar değiştirebildiğini tetkik edecek ve doğamıza ne kadar hükmedebildiğimizi göreceğiz."
          finish="2022"
          read="Devam ediyor..."
          star="☆☆☆☆☆ (?)"
          format="Basılı yayım"
          img="/image/2025/ezbere-yasayanlar.jpg"
          categories={["Antropoloji", "Sosyoloji", "Psikoloji"]}
          />
    </div>
    </section>
    <br /><br />
    <section>
    <h2 class="contact-title">Okumayı Bitirdiklerim</h2><br />
    <div class="grid grid-cols-1 md:grid-cols-1 gap-6">
      <LinkCard
        title="Scrum - İki Katı İşi Yarı Zamanda Yapma Sanatı"
        writer="A. Jeff Sutherland (ABD, June 20, 1941)"
        desc="Scrum'ın ortak yaratıcısı Jeff Sutherland, bu hafif çerçeve yapısının ekiplerin sonuç üretme biçiminde nasıl devrim yarattığına dair etkileyici bir anlatım ile sunuyor"
        finish="2019"
        read="06.03.2026"
        star="★★★✬☆ (3,5 / 5)"
        format="Kağıt Kitap"
        url="/blog/scrum-iki-kati-isi-yarim-zamanda-yapma-sanati"
        img="https://m.media-amazon.com/images/I/61b6FEjerYL._SL1243_.jpg"
        categories={["İş Dünyası", "Kurgu Dışı", "Kişisel Gelişim"]}
        />
  </div>
    <div class="grid grid-cols-1 md:grid-cols-1 gap-6">
      <LinkCard
        title="Zamanı Durdurmanın Yolları"
        writer="Matt Haig (İngiltere, 3 July 1975)"
        desc="Zamanı Nasıl Durdurursun, İngiliz yazar Matt Haig tarafından kaleme alınan ve Temmuz 2017'de yayımlanan tarihi fantastik bir romandır."
        finish="2017"
        read="26.01.2026"
        star="★★★☆☆ (3,2 / 5)"
        format="E-Kitap"
        url="/blog/zamani-durdurmanin-yollari"
        img="https://upload.wikimedia.org/wikipedia/en/2/2c/How_to_Stop_Time.jpg"
        categories={["Fantastik Kurgu", "Romantizm", "Tarih"]}
        />
  </div>
    <div class="grid grid-cols-1 md:grid-cols-1 gap-6">
        <LinkCard
          title="Gulliver'in Gezileri"
          writer="Jonathan Swift (İrlanda, 1667-1745)"
          desc="Genellikle bir çocuk kitabı olarak bilinmesine rağmen, aslında politik, toplumsal ve dinsel eleştiriler içeren bir yetişkin kurgusudur."
          finish="1726"
          read="11.11.2025"
          star="★★★✬☆ (3,5 / 5)"
          format="E-Kitap"
          url="/blog/gulliverin-gezileri"
          img="/image/2025/gulliverin-gezileri.jpg"
          categories={["Hiciv (Taşlama) Romanı", "Macera", "Kurgu"]}
          />
    </div>
    <br />
    <section>
  </MainCard>
</BaseLayout>