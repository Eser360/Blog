---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@config";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import Success from "@/components/mdx/Success.astro";
---

<BaseLayout title="İletişim">
  <MainCard
    title="İletişim Seçenekleri"
    description="Herhangi bir konuda benimle iletişime geçmekten çekinmeyin."
    textOverlay="İLETİŞİM"
    infoIcon="lucide:contact"
  >
  <br />  
  <Success>İletişime geçtiğiniz için teşekkürler. <br /> En kısa sürede size geri dönüş yapıyor olacağım.</Success>
   <br /><br />
  
   <div class="text-center">
    <h2 class="contact-title">🚴 Biraz daha gezinmeye ne dersin?</h2><br />
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="/blog" class="btn btn-primary gap-2 btn-shine-effect">
        <Icon name="lucide:book-open" class="w-5 h-5" />
        <span>Blog'u Keşfet</span>
      </a>
    </div>
  </div>
  </MainCard>
</BaseLayout>