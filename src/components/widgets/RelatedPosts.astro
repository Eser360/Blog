---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import dayjs from "@utils/dayjs";
import { DATE_FORMAT, t } from "@config";

interface Props {
  posts: CollectionEntry<"blog">[];
  currentCategories?: string[];
  currentTags?: string[];
}

const { posts = [], currentCategories = [], currentTags = [] } = Astro.props;
const categorySet = new Set(currentCategories);
const tagSet = new Set(currentTags);

const translatedHeading = t("label.relatedPosts");
const headingText = translatedHeading === "label.relatedPosts" ? "Benzer Yazılar" : translatedHeading;
---

{
  posts.length > 0 && (
    <section aria-labelledby="related-posts-heading" class="related-posts mt-8 pt-6 border-t border-base-content/15">
      <div class="flex items-center gap-2 mb-4">
        <Icon name="lucide:sparkles" class="w-5 h-5 text-primary shrink-0" />
        <h2 id="related-posts-heading" class="related-posts-heading text-xl sm:text-2xl font-bold">
          {headingText}
        </h2>
      </div>

      <ul class="related-posts-grid grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0">
        {posts.map((post) => {
          const displayDate = post.data.pubDate ? dayjs(post.data.pubDate).format(DATE_FORMAT) : "";
          const categories: string[] = post.data.categories ?? [];
          const tags: string[] = post.data.tags ?? [];

          return (
            <li class="min-w-0">
              <a
                href={`/blog/${post.slug}`}
                class="related-post-link group block h-full rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                <article class="related-post-card h-full rounded-xl bg-base-200/60 border border-base-content/10 p-4 transition-colors duration-200 group-hover:bg-base-200 group-hover:border-primary/40">
                  <header class="related-post-header">
                    <h3 class="related-post-title text-base font-semibold text-base-content group-hover:text-primary transition-colors">
                      {post.data.title}
                    </h3>
                    {displayDate && (
                      <time
                        datetime={new Date(post.data.pubDate).toISOString()}
                        class="related-post-date text-xs text-base-content/65 whitespace-nowrap"
                      >
                        {displayDate}
                      </time>
                    )}
                  </header>

                  {(categories.length > 0 || tags.length > 0) && (
                    <div class="flex flex-wrap gap-1.5 mt-3">
                      {categories.map((category: string) => (
                        <span
                          class:list={[
                            "inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-medium",
                            categorySet.has(category)
                              ? "bg-primary/15 text-primary"
                              : "bg-base-300/70 text-base-content/75",
                          ]}
                        >
                          <Icon name="lucide:folder" class="w-3 h-3 shrink-0" />
                          <span>{category}</span>
                        </span>
                      ))}
                      {tags.map((tag: string) => (
                        <span
                          class:list={[
                            "inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-medium",
                            tagSet.has(tag)
                              ? "bg-secondary/15 text-secondary"
                              : "bg-base-300/50 text-base-content/70",
                          ]}
                        >
                          <Icon name="lucide:tag" class="w-3 h-3 shrink-0" />
                          <span>{tag}</span>
                        </span>
                      ))}
                    </div>
                  )}
                </article>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}

<style>
  .related-posts-heading,
  .related-post-title {
    text-wrap: balance;
  }

  .related-post-card {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .related-post-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  @container (min-width: 24rem) {
    .related-post-header {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.75rem;
    }
  }
</style>
